VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Naver Maps JavaScript API v3 — public Client ID only (NCP Application key id).
# Register dev origins in Naver Cloud Console Web service URL (e.g. http://localhost:3000, http://127.0.0.1:3000).
# VITE_NAVER_MAP_CLIENT_ID=

# Optional: API base for production/preview builds. If set at build time, the app uses this
# and does not call /api/config. If unset, the client fetches /api/config (same origin).
# Local dev (pnpm run dev) skips the fetch and uses this or the default in src/lib/config.ts.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: bootstrap super-admin email (must match a row in dk_super_bootstrap_emails after RLS migration)
# VITE_SUPER_ADMIN_EMAIL=dreamkids617@gmail.com

# Optional: site URL for sitemap / blog canonical (no trailing slash), e.g. https://dreamkids.vercel.app
# VITE_SITE_URL=

# Optional: build-time meta overrides
# VITE_APP_TITLE=
# VITE_APP_DESCRIPTION=
# VITE_APP_LOGO_URL=
# VITE_TWITTER_SITE=
# VITE_TWITTER_CREATOR=

# Local Vite port (default 3000)
# VITE_PORT=3000
